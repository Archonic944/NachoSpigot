<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.sonatype.oss</groupId>
        <artifactId>oss-parent</artifactId>
        <version>7</version>
    </parent>

    <groupId>dev.cobblesword.nachospigot</groupId>
    <artifactId>parent</artifactId>
    <version>dev-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>NachoSpigot-Parent</name>
    <description>Parent project for all NachoSpigot modules.</description>

    <modules>
        <module>NachoSpigot-Server</module>
        <module>NachoSpigot-API</module>
    </modules>

    <build>
        <defaultGoal>clean install</defaultGoal>
    </build>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <org-yaml.snakeyaml.version>2.0</org-yaml.snakeyaml.version>
        <org-xerial.sqlite-jdbc.version>3.41.2.2</org-xerial.sqlite-jdbc.version>
        <mysql.mysql-connector-java.version>8.0.16</mysql.mysql-connector-java.version>
        <org-apache-commons.commons-lang3.version>3.18.0</org-apache-commons.commons-lang3.version>
        <junit.junit.version>4.13.1</junit.junit.version>
        <io-netty.netty-codec-http2.version>4.1.100.Final</io-netty.netty-codec-http2.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${org-yaml.snakeyaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${org-xerial.sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql.mysql-connector-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${org-apache-commons.commons-lang3.version}</version>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.junit.version}</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-http2</artifactId>
                <version>${io-netty.netty-codec-http2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
